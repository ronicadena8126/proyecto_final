# Copia este archivo a .env y completa los valores. NUNCA subas .env ni .env_encoded al repositorio.

# --- Snowflake (mismo usuario de servicio key-pair del PSet 2) ---
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=PSET2_SVC
# ruta ABSOLUTA
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/<tu_usuario>/.snowflake/pset2_rsa_key.p8
SNOWFLAKE_ROLE=PSET2_ROLE
SNOWFLAKE_WAREHOUSE=PSET2_WH
SNOWFLAKE_DATABASE=PSET2_MORA

# --- Almacén de las tablas de operación: snowflake (producción) o local (DuckDB, pruebas) ---
ALMACEN=snowflake

# --- MLflow (desde tu máquina; dentro de Docker se usa http://mlflow:5000) ---
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_DB_PASSWORD=mlflow

# --- API ---
API_URL=http://localhost:8000
# protege /admin/* (interruptor, recarga, volcado)
ADMIN_TOKEN=cambia-este-token-largo-y-aleatorio
# 1 = la API arranca sirviendo la regla de negocio
MODO_RESPALDO=0
# cada cuánto revisa si cambió @champion
RECARGA_SEGUNDOS=30
# dueño de la imagen en GitHub Container Registry
GHCR_OWNER=ronicadena8126
# o el hash corto del commit publicado por cd.yml
API_TAG=latest

# --- Kestra ---
KESTRA_USER=admin@kestra.io
KESTRA_PASSWORD=Admin1234
